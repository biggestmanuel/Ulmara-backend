# Ulmara backend — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; NEVER commit a
# filled-in copy.
#
#   cp .env.example .env
#
# Two failure modes to be aware of:
#   * Required variables below have no default. The process refuses to boot
#     without them (see src/config/env.ts).
#   * Production-only consistency rules: with NODE_ENV=production the app
#     REFUSES TO START if the selected email provider or ramp provider has no
#     credentials, and if ALLOWED_ORIGINS contains a non-https origin. This is
#     deliberate — fail at boot, not on a user's first tap.
#
# ---------------------------------------------------------------------------
# 1. Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated CORS allowlist. Must be non-empty; in production every entry
# must start with https://.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000,http://localhost:3000

# --- Reverse proxies (READ THIS IF THE APP IS NOT DIRECTLY REACHABLE) -------
# The rate limiter keys on `request.ip`, so how Fastify computes that IP decides
# whether rate limiting works at all.
#
#   TRUSTED_PROXIES unset  ->  request.ip is the immediate TCP peer. Correct for a
#                             directly-reachable app. WRONG behind a reverse
#                             proxy: every user in the world then shares ONE
#                             budget per route, so a single abusive client can
#                             lock everyone else out of /login, /verify-pin, etc.
#                             That is a denial of service, not a cosmetic bug.
#   TRUSTED_PROXIES=list   ->  request.ip becomes the leftmost UNTRUSTED entry in
#                             X-Forwarded-For, i.e. the real client. List the
#                             proxy addresses or CIDRs, e.g.
#                             "10.0.0.0/8,172.17.0.1". This is the recommended
#                             form: an unrecognised peer is simply not trusted.
#   TRUSTED_PROXIES=*      ->  trusts ANY X-Forwarded-For. Only safe when a
#                             proxy you control OVERWRITES the header. If the
#                             app is directly internet-reachable, a client can
#                             then forge the header to get a fresh rate-limit
#                             budget, or to burn someone else's.
#
# Examples:
#   single nginx on the same host   TRUSTED_PROXIES=127.0.0.1,::1
#   nginx in a docker bridge network  TRUSTED_PROXIES=172.16.0.0/12
#   AWS ALB                          leave unset if the ALB sets X-Forwarded-For
#                                   and nothing else can reach the app, otherwise
#                                   TRUSTED_PROXIES=<the ALB's subnet>
# TRUSTED_PROXIES=
# Alternative form: trust exactly N proxy hops. Use when the chain length is
# fixed and known. Ignored if TRUSTED_PROXIES is non-empty.
# TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# 2. Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Neon dashboard -> Connection Details -> "Pooled connection" for DATABASE_URL
# (the -pooler host) and "Direct connection" for DIRECT_URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional. Used for migrations, where a direct (non-pooled) connection avoids
# PgBouncer transaction pooling interfering with DDL.
DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# 3. Redis / BullMQ
# ---------------------------------------------------------------------------
# Local:  docker start avora-redis
# Production: a managed Redis (ElastiCache, Upstash, Redis Cloud). See
# OPERATIONS.md for persistence and durability requirements.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# 4. JWT signing + ROTATION  (see README "JWT rotation procedure")
# ---------------------------------------------------------------------------
# At least 32 characters. Generate with:  openssl rand -hex 32
# This is the CURRENT key and the ONLY key new tokens are signed with.
JWT_SECRET=

# Session token lifetime (jsonwebtoken duration string).
JWT_EXPIRES_IN=7d

# During a rotation window only, set BOTH of the following:
#   JWT_PREVIOUS_SECRET       the key being retired (the OLD JWT_SECRET)
#   JWT_PREVIOUS_SECRET_RETIRE_AT  ISO-8601 instant; after it, the old key is
#                                   rejected. The window must be LONGER than
#                                   JWT_EXPIRES_IN so no live session breaks.
# Leave both EMPTY/unset in steady state.
# JWT_PREVIOUS_SECRET=
# JWT_PREVIOUS_SECRET_RETIRE_AT=

# ---------------------------------------------------------------------------
# 5. Email / OTP verification  (Section 1)
# ---------------------------------------------------------------------------
# One of: resend | sendgrid | ses
EMAIL_PROVIDER=resend

# Envelope sender. The sending domain must be verified with the provider.
EMAIL_FROM=no-reply@ulmara.app
EMAIL_FROM_NAME=Ulmara

# --- Resend (default) ---
# resend.com -> API Keys -> "Sending" -> Create API key.
RESEND_API_KEY=

# --- SendGrid (EMAIL_PROVIDER=sendgrid) ---
# sendgrid.com -> Settings -> API Keys. Must be a FULL ACCESS key.
# SENDGRID_API_KEY=
# Optional: SendGrid rejects any sender outside your verified-sender list, so
# this overrides EMAIL_FROM when set.
# SENDGRID_FROM_EMAIL=no-reply@ulmara.app

# --- AWS SES (EMAIL_PROVIDER=ses) ---
# IAM user with ses:SendEmail, plus the SES region and a verified identity.
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=

# Code lifetime in Redis. Keep at 600 (10 minutes) unless there is a reason.
OTP_TTL_SECONDS=600
# How long an expired record is retained purely so a late submit can be told
# "expired" rather than the less useful "invalid code".
OTP_EXPIRY_GRACE_SECONDS=3600
# Wrong-code budget per issued code (guards the 6-digit space).
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# 6. Verification mode
# ---------------------------------------------------------------------------
# false is the normal PRODUCTION path: codes are emailed and never returned.
# true is for local development ONLY, and is refused in production. When true
# (and NODE_ENV != production) the code is additionally returned in the API
# response and written to a WARN log line so you can complete the flow without
# an inbox. Never enable this on a deployed environment.
DEV_VERIFICATION_MODE=false

# ---------------------------------------------------------------------------
# 7. Error tracking / monitoring  (Section 4)
# ---------------------------------------------------------------------------
# With SENTRY_DSN unset, error tracking is disabled and nothing about the app's
# behaviour changes. Get the DSN from sentry.io -> Project -> Settings ->
# Client Keys (DSN).
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=ulmara-backend@<git-sha>
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_DEBUG=false

# Bearer token protecting /internal/queues and /internal/config. At least 16
# chars. If UNSET: those routes are open in development and return 404 in
# production. Generate with: openssl rand -hex 24
# INTERNAL_API_TOKEN=

# Structured queue-depth log cadence in ms. 0 disables the periodic log.
QUEUE_DEPTH_LOG_INTERVAL_MS=300000

# Serve the generated OpenAPI 3.1 document. `true` exposes:
#   GET /docs/json  the raw document
#   GET /docs       a route listing
# The document is built from the live Fastify route table, so it cannot describe
# a route that does not exist. IGNORED IN PRODUCTION regardless of this value:
# an unauthenticated inventory of every route and its auth requirement is
# reconnaissance, not documentation. Set it to `true` locally if you want to
# load /docs/json into Swagger Editor, Redoc or Postman.
ENABLE_API_DOCS=false

# ---------------------------------------------------------------------------
# 8. Chains  (Section 3 / Section 10)
# ---------------------------------------------------------------------------
# Chain ids select which network each chain is pointed at. Changing these is a
# CONFIG change; no code change is needed. Every signed-transaction
# verification, token registry lookup and adapter binding reads them here.
ETHEREUM_CHAIN_ID=11155111        # 11155111 Sepolia | 1 Ethereum mainnet
# BNB Smart Chain: 97 testnet | 56 mainnet
# BSC_CHAIN_ID=56
# Base: 84532 Sepolia | 8453 mainnet
# BASE_CHAIN_ID=8453
# Polygon: 80002 Amoy | 137 mainnet
# POLYGON_CHAIN_ID=137

# RPC endpoints. Only the chains you actually serve need one; a chain with no
# RPC is reported as a configuration problem by /internal/config.
# ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# BASE_RPC_URL=https://sepolia.base.org
# POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Solana: devnet https://api.devnet.solana.com | mainnet https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Which public Solana cluster SOLANA_RPC_URL points at: devnet or mainnet.
# A mint address only means anything on the cluster it was issued on, so this is
# resolved explicitly rather than inferred silently. Unset: inferred from the
# RPC URL, defaulting to devnet. Set it when you use a self-hosted RPC, which
# carries no cluster signal.
# SOLANA_CLUSTER=devnet

# Extra SPL tokens for the current cluster, as a JSON array:
#   [{"symbol":"USDT","name":"Tether USD","decimals":6,
#     "address":"<base58 mint>","program":"spl-token"}]
# Same contract as ERC20_TOKEN_CONFIG: malformed entries are dropped with a
# warning rather than taking the API down, and the verified seed entries still
# apply. `npm run verify:solana` proves each entry against the chain.
# SOLANA_SPL_TOKENS=""  
# TRON_RPC_URL=https://api.shasta.trongrid.io
# TON_RPC_URL=https://testnet.ton.org

# Bitcoin Core JSON-RPC (balance/fee/broadcast/confirmation). Transaction
# construction is client-owned.
# BTC_RPC_URL=http://127.0.0.1:8332
# BTC_RPC_USER=
# BTC_RPC_PASSWORD=

# TriVerify address/network validation API key.
# TRIVERIFY_API_KEY=

# Extra ERC-20 tokens: a JSON array that ADDS or OVERRIDES registry entries.
# The built-in table already covers the verified USDC/USDT deployments on
# Ethereum, BSC, Base and Polygon (mainnet and testnet). Use this only to add a
# network the table does not know, or to correct one. A malformed value is
# logged and ignored, never fatal.
# Verify whatever you add against the live network with:  npm run verify:tokens
# ERC20_TOKEN_CONFIG=[{"chain":"BSC","chainId":97,"symbol":"USDT","address":"0x...","decimals":18,"name":"Test USDT"}]

# ---------------------------------------------------------------------------
# 9. NGN fiat ramp  (Section 12)
# ---------------------------------------------------------------------------
# One of: bitnob | yellowcard
RAMP_PROVIDER=bitnob

# Per-provider Naira limits applied before any provider call.
RAMP_MIN_NGN=1000
RAMP_MAX_NGN=5000000

# --- Bitnob ---
# app.bitnob.com -> Settings -> API Keys. These are a CLIENT ID + CLIENT SECRET
# pair (used for per-request HMAC signing), not a bearer token. BITNOB_API_KEY
# holds the client id.
# BITNOB_BASE_URL=https://api.bitnob.com
# BITNOB_API_KEY=
# BITNOB_CLIENT_SECRET=
# Webhook secret from the Bitnob dashboard -> Webhooks. Used ONLY to verify the
# x-bitnob-signature header; never sent outbound.
# BITNOB_WEBHOOK_SECRET=

# --- Yellow Card ---
# Yellow Card dashboard -> Developers -> API keys. Sandbox base URL is
# https://sandbox.api.yellowcard.io — use it for testing.
# YELLOW_CARD_BASE_URL=https://api.yellowcard.io
# YELLOW_CARD_API_KEY=
# YELLOW_CARD_API_SECRET=
# Yellow Card signs webhooks with the SAME secret as the API key, so no
# separate webhook secret variable is needed.

# ---------------------------------------------------------------------------
# 10. WebSocket
# ---------------------------------------------------------------------------
# /ws?token=<jwt>. No additional configuration; the connection is authenticated
# with the same JWT_SECRET-based session token used by the REST API.
