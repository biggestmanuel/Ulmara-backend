generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Chain {
  TON
  BSC
  ETH
  SOL
  BASE
  POLYGON
  TRON
  BTC
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RampType {
  DEPOSIT
  WITHDRAWAL
}

enum RampStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentRequestStatus {
  OPEN
  FULFILLED
  EXPIRED
  CANCELLED
}

enum ExternalIntentStatus {
  READY
  USED
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  phone             String?   @unique
  passwordHash      String
  pinHash           String?
  name              String?
  photoUrl          String?
  emailVerified     Boolean   @default(false)
  phoneVerified     Boolean   @default(false)
  biometricEnabled  Boolean   @default(false)
  twoFactorEnabled  Boolean   @default(false)
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  defaultCurrency   String    @default("NGN")
  defaultLanguage   String    @default("en")
  defaultNetwork    Chain?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accountId               AccountId?
  wallets                 Wallet[]
  sentTransactions        Transaction[]            @relation("SentTransactions")
  paymentRequests         PaymentRequest[]
  rampTransactions        RampTransaction[]
  sessions                Session[]
  externalTransferIntents ExternalTransferIntent[]
}
model AccountId {
  id        String   @id @default(uuid())
  accountId String   @unique @db.VarChar(10)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([accountId])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain     Chain
  address   String
  createdAt DateTime @default(now())

  @@unique([userId, chain])
  @@index([address])
}

model Transaction {
  id                 String                  @id @default(uuid())
  senderId           String
  sender             User                    @relation("SentTransactions", fields: [senderId], references: [id])
  recipientAccountId String?
  recipientAddress   String?
  asset              String
  amount             Decimal                 @db.Decimal(36, 18)
  network            Chain
  feeAmount          Decimal?                @db.Decimal(36, 18)
  status             TransactionStatus       @default(PENDING)
  txHash             String?
  // Client-generated UUID, one per transfer attempt. Retries (mobile network
  // timeout-and-retry, double-tap racing the disabled button) replay the
  // original row instead of creating a second transfer. Nullable: rows from
  // before the field existed have no key.
  idempotencyKey     String?                 @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  receipt            Receipt?
  externalIntent     ExternalTransferIntent?

  @@index([senderId])
  @@index([recipientAccountId])
  @@index([status])
}

// A server-verified plan for a client-signed external transfer. The client
// prepares (PIN + recipient validated via TriVerify), signs locally with keys
// that never leave the device, then submits the signature. The backend decodes
// the signature and verifies it matches this record before broadcasting.
model ExternalTransferIntent {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain         Chain
  asset         String
  amount        Decimal              @db.Decimal(36, 18)
  recipient     String
  fee           String?
  status        ExternalIntentStatus @default(READY)
  expiresAt     DateTime
  usedAt        DateTime?
  transactionId String?              @unique
  transaction   Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

model Contact {
  id        String   @id @default(uuid())
  ownerId   String
  accountId String?
  name      String
  address   String?
  chain     Chain?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Receipt {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model PaymentRequest {
  id                     String               @id @default(uuid())
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset                  String
  amount                 Decimal?             @db.Decimal(36, 18)
  /// Free-text note shown to whoever pays the request. Optional, max 140 chars.
  note                   String?
  status                 PaymentRequestStatus @default(OPEN)
  expiresAt              DateTime?
  createdAt              DateTime             @default(now())
  fulfilledTransactionId String?              @unique
  fulfilledAt            DateTime?

  @@index([userId])
}

model RampTransaction {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      RampType
  amountNgn Decimal    @db.Decimal(18, 2)
  provider  String
  reference String     @unique
  status    RampStatus @default(PENDING)
  // Provider-side correlation ids and the payment instructions handed to the
  // user, so a webhook or a support agent can reconcile a transaction without
  // re-querying the provider.
  providerReference    String?
  providerCustomerId   String?
  paymentInstructions  Json?
  failureReason        String?
  providerAmountNgn    Decimal?   @db.Decimal(18, 2)
  providerStatusRaw    String?
  lastSyncedAt         DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([reference])
  @@index([status])
}

// One row per provider webhook delivery. The provider event id is unique, so
// a redelivery (Bitnob retries up to 3 times) loses the insert race and is
// acknowledged without being applied twice.
model RampWebhookEvent {
  id             String   @id @default(uuid())
  provider       String
  // Stable across retries for the same logical event.
  eventId        String
  eventType      String
  reference      String?
  signatureValid Boolean  @default(false)
  status         String?
  payload        Json
  receivedAt     DateTime @default(now())
  processedAt    DateTime?

  @@unique([provider, eventId])
  @@index([reference])
  @@index([processedAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
