tmp/
temp/

# BullMQ / Redis local data
*.rdb

# Test artifacts
.nyc_output/

# Throwaway Solana Devnet keypair for scripts/verify-solana-spl-e2e.ts.
# A real secret, never commit it.
.solana-e2e-keypair.json

# Throwaway TLS CA/server certificates generated by verify:redis:tls.
# A private key must never be committed, even a test one.
.tls-test-certs/
