# Dependencies
node_modules/

# Environment variables
# Broadened to catch non-dotfile names -- the live credential file is
# `~/dev/ulmara-fe-backend.env`, a `*.env` name, and nothing here ignored it.
# `.env.*` is what catches the backup class: a stray `*.env.bak` holding
# RESEND_API_KEY was created once and had to be hunted down and deleted.
# The negations must stay LAST. gitignore is last-match-wins, so a
# `!.env.example` above `*.env.*` would silently stop un-ignoring it and
# `.env.example` would disappear from the repository on the next commit.
.env
.env.*
*.env
*.env.*
!.env.example
!.env.sample
!.env.template

# Build output
dist/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

